<section class="reservation" id="reservation">
	<div class="container reservation-inner">
		<p class="eyebrow eyebrow-light">Réservation</p>
		<h2>Votre table vous attend.</h2>
		<p class="reservation-text">Réservez votre prochaine expérience à L'Atelier.</p>
		<div class="reservation-details">
			<p>📍 24 rue fictive, 75011 Paris</p>
			<p>📞 01 00 00 00 00</p>
		</div>
		<a href="tel:0100000000" class="btn btn-primary">Réserver une table</a>
	</div>
</section>

<style>
	.reservation {
		padding: 8rem 0;
		background: var(--color-brown-dark);
		color: var(--color-cream);
		text-align: center;
	}

	.reservation-inner {
		max-width: 560px;
		margin: 0 auto;
	}

	.reservation h2 {
		font-size: 2.5rem;
		margin: 0.75rem 0 1rem;
	}

	.reservation-text {
		font-size: 1.1rem;
		color: var(--color-cream-soft);
		margin-bottom: 2rem;
	}

	.reservation-details {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 2.5rem;
		font-size: 1rem;
		color: var(--color-cream-soft);
	}
</style>

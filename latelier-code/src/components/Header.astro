---
---

<header class="site-header">
	<div class="container header-inner">
		<a href="#" class="logo">L'ATELIER</a>
		<nav class="nav-links">
			<a href="#carte">La Carte</a>
			<a href="#experience">L'Expérience</a>
			<a href="#reservation">Réservation</a>
		</nav>
		<a href="#reservation" class="btn btn-primary btn-sm">Réserver</a>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		background: rgba(27, 23, 18, 0.85);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		border-bottom: 1px solid rgba(247, 242, 231, 0.08);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 4.5rem;
	}

	.logo {
		font-family: var(--font-serif);
		font-size: 1.25rem;
		letter-spacing: 0.12em;
		color: var(--color-cream);
	}

	.nav-links {
		display: flex;
		gap: 2.25rem;
	}

	.nav-links a {
		color: var(--color-cream-soft);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		opacity: 0.85;
		transition: opacity 0.2s ease;
	}

	.nav-links a:hover {
		opacity: 1;
	}

	.btn-sm {
		padding: 0.6rem 1.4rem;
		font-size: 0.7rem;
	}

	@media (max-width: 720px) {
		.nav-links {
			display: none;
		}
	}
</style>

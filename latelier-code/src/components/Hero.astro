---
const heroImage =
	'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=1800&q=75';
const heroStyle = `background-image: linear-gradient(180deg, rgba(20,16,12,0.5) 0%, rgba(20,16,12,0.75) 60%, rgba(20,16,12,0.95) 100%), url(${heroImage});`;
---

<section class="hero" style={heroStyle}>
	<div class="container hero-inner">
		<p class="eyebrow">Bistrot français contemporain — Paris</p>
		<h1>L'ATELIER</h1>
		<p class="tagline">Le bistrot français, autrement.</p>
		<p class="hero-text">
			Une cuisine de saison, des produits soigneusement sélectionnés et une ambiance chaleureuse au
			cœur de Paris.
		</p>
		<div class="hero-actions">
			<a href="#reservation" class="btn btn-primary">Réserver une table</a>
			<a href="#carte" class="btn btn-outline btn-light">Découvrir la carte</a>
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 100vh;
		display: flex;
		align-items: flex-end;
		background-size: cover;
		background-position: center;
		color: var(--color-cream);
		padding-top: 4.5rem;
	}

	.hero-inner {
		padding-bottom: 6rem;
		max-width: 640px;
	}

	.hero h1 {
		font-size: clamp(3rem, 7vw, 5.5rem);
		letter-spacing: 0.02em;
		margin: 0.75rem 0 0.5rem;
	}

	.tagline {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.4rem;
		color: var(--color-olive-soft);
		margin-bottom: 1.25rem;
	}

	.hero-text {
		font-size: 1.05rem;
		color: var(--color-cream-soft);
		max-width: 520px;
		margin-bottom: 2.25rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.btn-light {
		color: var(--color-cream);
	}

	@media (max-width: 640px) {
		.hero-inner {
			padding-bottom: 3.5rem;
		}
	}
</style>
